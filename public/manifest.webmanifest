{
  "name": "Dr Pocket · My health",
  "short_name": "Dr Pocket",
  "description": "Notes, X-rays, exercise and progress reports for each health problem.",
  "id": "/health/",
  "start_url": "/health/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EDF1EF",
  "theme_color": "#0A7A66",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log exercise", "url": "/health/#/exercise", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New problem", "url": "/health/#/problem/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
